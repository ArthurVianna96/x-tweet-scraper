# Copy to `.env` for local runs. `.env` is gitignored; this file is not.
#
# On the Apify platform these come from the Actor's environment variables, not from a
# file — see `.actor/actor.json` and `docs/DEPLOYMENT.md`. Nothing here is read at build
# time.

# ---------------------------------------------------------------------------
# Entitlements (the free-tier gate)
# ---------------------------------------------------------------------------
# Without both of these, every run resolves to `entitlement_unavailable` and is capped at
# 10 results. That is the correct fail-closed behaviour, not a misconfiguration error —
# the run will succeed, log a warning, and return 10.

# Public-read key-value store that only your account can write: "username/store-name".
ENTITLEMENTS_STORE_ID=

# The authority behind the gate. Generate with:  openssl rand -hex 32
#
# On Apify this MUST be marked Secret. A published Actor's non-secret environment
# variables are publicly visible on its detail page, so a plain env var would publish the
# key itself — a total compromise of the gate (README §4.2).
ENTITLEMENTS_HMAC_KEY=

# ---------------------------------------------------------------------------
# Apify
# ---------------------------------------------------------------------------
# Only needed locally, and only for provisioning (src/tools/entitlement-key.ts) or to use
# Apify Proxy from a local run. Inside a real run the platform injects this — and there it
# is the *runner's* token, which is why the gate never trusts it for identity claims.
APIFY_TOKEN=
