{
  "name": "x-tweet-scraper",
  "version": "0.1.0",
  "description": "Browserless X (Twitter) tweet scraper — Apify Actor built on guest-token GraphQL, with a server-side free-tier gate.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/actor/main.js",
    "start:dev": "tsx src/actor/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe": "node scripts/probe-x-endpoints.mjs"
  },
  "dependencies": {
    "apify": "^3.2.6",
    "apify-client": "^2.25.0",
    "got-scraping": "^4.0.6",
    "header-generator": "^2.1.88",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "private": true
}
